# Environment variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/moalemy?schema=public"
# Same connection for local Postgres; use Neon’s unpooled URL here if DATABASE_URL uses the pooler
DIRECT_URL="postgresql://user:password@localhost:5432/moalemy?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Firebase (for Auth & FCM)
# Download serviceAccountKey.json from Firebase Console
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
