// Prisma Schema for Mo3alemy API
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserType {
  teacher
  parent
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ContactRequestStatus {
  pending
  accepted
  rejected
}

enum TutorRequestStatus {
  active
  fulfilled
  closed
}

enum LessonType {
  at_teacher
  at_student
  group
  any
}

enum ClientAccountKind {
  student
  guardian
}

enum RequestTarget {
  self
  dependent
}

enum StudyMode {
  online
  offline
  both
}

// ============================================
// TABLES
// ============================================

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  email        String?    @unique
  passwordHash String     @map("password_hash")
  name         String
  avatarUrl    String?    @map("avatar_url")
  userType     UserType   @map("user_type")
  status       UserStatus @default(active)
  fcmToken     String?    @map("fcm_token")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  teacher Teacher?
  parent  Parent?

  @@index([phone])
  @@index([userType, status])
  @@map("users")
}

model Teacher {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  bio             String?
  experienceYears Int?     @map("experience_years")
  qualification   String?
  areaId          String?  @map("area_id")
  lessonTypes     Json     @default("[\"at_teacher\", \"at_student\"]") @map("lesson_types")
  isVerified      Boolean  @default(false) @map("is_verified")
  viewsCount      Int      @default(0) @map("views_count")
  avgRating       Decimal  @default(0) @map("avg_rating") @db.Decimal(2, 1)
  ratingCount     Int      @default(0) @map("rating_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area?             @relation(fields: [areaId], references: [id])
  subjects        TeacherSubject[]
  favorites       Favorite[]
  contactRequests ContactRequest[]
  comparisonItems ComparisonItem[]
  whatsappClicks  WhatsAppClick[]

  @@index([areaId])
  @@map("teachers")
}

model Parent {
  id                String            @id @default(uuid())
  userId            String            @unique @map("user_id")
  areaId            String?           @map("area_id")
  clientAccountKind ClientAccountKind @default(guardian) @map("client_account_kind")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area?            @relation(fields: [areaId], references: [id])
  children        ParentChild[]
  favorites       Favorite[]
  contactRequests ContactRequest[]
  tutorRequests   TutorRequest[]
  comparisons     Comparison[]
  whatsappClicks  WhatsAppClick[]

  @@index([areaId])
  @@map("parents")
}

model ParentChild {
  id        String   @id @default(uuid())
  parentId  String   @map("parent_id")
  name      String
  stageId   String   @map("stage_id")
  schoolType String?  @map("school_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent        Parent              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  stage         Stage               @relation(fields: [stageId], references: [id])
  subjects      ParentChildSubject[]
  tutorRequests TutorRequest[]

  @@index([parentId])
  @@map("parent_children")
}

model ParentChildSubject {
  id            String @id @default(uuid())
  parentChildId String @map("parent_child_id")
  subjectId     String @map("subject_id")

  parentChild ParentChild @relation(fields: [parentChildId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id])

  @@unique([parentChildId, subjectId])
  @@map("parent_child_subjects")
}

model Subject {
  id        String   @id @default(uuid())
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  teacherSubjects      TeacherSubject[]
  parentChildSubjects  ParentChildSubject[]
  contactRequests      ContactRequest[]
  tutorRequests        TutorRequest[]

  @@map("subjects")
}

model Stage {
  id        String   @id @default(uuid())
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  sortOrder Int      @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  teacherSubjects TeacherSubject[]
  parentChildren  ParentChild[]
  contactRequests ContactRequest[]
  tutorRequests   TutorRequest[]

  @@map("stages")
}

model TeacherSubject {
  id              String   @id @default(uuid())
  teacherId       String   @map("teacher_id")
  subjectId       String   @map("subject_id")
  stageId         String   @map("stage_id")
  priceAtTeacher  Int?     @map("price_at_teacher")
  priceAtStudent  Int?     @map("price_at_student")
  priceGroup      Int?     @map("price_group")
  priceOnline     Int?     @map("price_online")
  priceOffline    Int?     @map("price_offline")
  priceNegotiable Boolean  @default(false) @map("price_negotiable")
  durationMinutes Int      @default(60) @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  stage   Stage   @relation(fields: [stageId], references: [id])

  @@unique([teacherId, subjectId, stageId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([stageId])
  @@map("teacher_subjects")
}

model Favorite {
  id        String   @id @default(uuid())
  parentId  String   @map("parent_id")
  teacherId String   @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([parentId, teacherId])
  @@map("favorites")
}

model ContactRequest {
  id        String               @id @default(uuid())
  parentId  String               @map("parent_id")
  teacherId String               @map("teacher_id")
  subjectId String?              @map("subject_id")
  stageId   String?              @map("stage_id")
  message   String?
  status    ContactRequestStatus @default(pending)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  parent  Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
  stage   Stage?   @relation(fields: [stageId], references: [id])

  @@index([teacherId, status])
  @@index([parentId])
  @@map("contact_requests")
}

model TutorRequest {
  id                  String             @id @default(uuid())
  parentId            String             @map("parent_id")
  parentChildId       String?            @map("parent_child_id")
  subjectId           String             @map("subject_id")
  stageId             String             @map("stage_id")
  description         String?
  preferredLessonType LessonType?        @map("preferred_lesson_type")
  requestTarget       RequestTarget      @default(dependent) @map("request_target")
  studyMode           StudyMode          @default(both) @map("study_mode")
  budgetMin           Int?               @map("budget_min")
  budgetMax           Int?               @map("budget_max")
  areaId              String?            @map("area_id")
  status              TutorRequestStatus @default(active)
  createdAt           DateTime           @default(now()) @map("created_at")
  expiresAt           DateTime?          @map("expires_at")

  parent      Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentChild ParentChild? @relation(fields: [parentChildId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id])
  stage       Stage        @relation(fields: [stageId], references: [id])
  area        Area?        @relation(fields: [areaId], references: [id])

  @@index([areaId, subjectId, stageId, status])
  @@index([parentId])
  @@map("tutor_requests")
}

model Comparison {
  id        String   @id @default(uuid())
  parentId  String   @map("parent_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  items  ComparisonItem[]

  @@map("comparisons")
}

model ComparisonItem {
  id           String   @id @default(uuid())
  comparisonId String   @map("comparison_id")
  teacherId    String   @map("teacher_id")
  addedAt      DateTime @default(now()) @map("added_at")

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, teacherId])
  @@map("comparison_items")
}

// ============================================
// LOCATION TABLES
// ============================================

model Governorate {
  id        String   @id @default(uuid())
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  cities City[]

  @@map("governorates")
}

model City {
  id            String      @id @default(uuid())
  governorateId String      @map("governorate_id")
  nameAr        String      @map("name_ar")
  nameEn        String?     @map("name_en")
  sortOrder     Int         @default(0) @map("sort_order")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  areas       Area[]

  @@index([governorateId])
  @@map("cities")
}

model Area {
  id        String   @id @default(uuid())
  cityId    String   @map("city_id")
  nameAr    String   @map("name_ar")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  teachers      Teacher[]
  parents       Parent[]
  tutorRequests TutorRequest[]

  @@index([cityId])
  @@map("areas")
}

model WhatsAppClick {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  parent  Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([parentId])
  @@map("whatsapp_clicks")
}
