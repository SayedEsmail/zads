# API
# Browser API requests use the same-origin /api proxy.
API_BASE_URL=http://127.0.0.1:3000

# Public site URL (sitemap, canonical, Open Graph)
NEXT_PUBLIC_APP_URL=https://zads.app

# Google Analytics 4 Measurement ID (zads.app stream)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-00DPVWBBDZ

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-here-change-in-production
AUTH_SECRET=your-secret-here-change-in-production
