# ===================================
# Zads Monorepo - Git Ignore
# ===================================

# ===================================
# General
# ===================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.log
*.tmp
*.temp

# ===================================
# Environment Files
# ===================================
.env
.env.local
.env.*.local
.env.production
.env.development

# ===================================
# IDE / Editors
# ===================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ===================================
# Node.js (API & Dashboard)
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# ===================================
# zads-api specific
# ===================================
zads-api/.env
zads-api/node_modules/

# ===================================
# zads-dashboard specific  
# ===================================
zads-dashboard/.env
zads-dashboard/.env.production
zads-dashboard/node_modules/
zads-dashboard/dist/
zads-dashboard/.vite/

# ===================================
# Flutter (zads_app)
# ===================================
# Miscellaneous
zads_app/*.class
zads_app/*.lock
zads_app/*.log
zads_app/*.pyc
zads_app/*.swp
zads_app/.atom/
zads_app/.buildlog/
zads_app/.history
zads_app/.svn/

# IntelliJ related
zads_app/*.iml
zads_app/*.ipr
zads_app/*.iws
zads_app/.idea/

# Flutter/Dart/Pub related
zads_app/.dart_tool/
zads_app/.flutter-plugins
zads_app/.flutter-plugins-dependencies
zads_app/.packages
zads_app/.pub-cache/
zads_app/.pub/
zads_app/build/
zads_app/.metadata

# Android related
zads_app/android/.gradle/
zads_app/android/app/debug/
zads_app/android/app/profile/
zads_app/android/app/release/
zads_app/android/local.properties
zads_app/android/key.properties
zads_app/android/*.jks
zads_app/android/*.keystore

# iOS/XCode related
zads_app/ios/.symlinks/
zads_app/ios/Pods/
zads_app/ios/Flutter/Flutter.framework/
zads_app/ios/Flutter/Flutter.podspec
zads_app/ios/.generated/
zads_app/ios/Flutter/Generated.xcconfig
zads_app/ios/Runner/GeneratedPluginRegistrant.*

# Coverage
coverage/
*.lcov

# Symbols
zads_app/app.*.symbols

# Obfuscation related
zads_app/app.*.map.json

# ===================================
# Build outputs
# ===================================
dist/
build/
*.apk
*.aab
*.ipa
*.app

# ===================================
# Secrets (NEVER commit these!)
# ===================================
*.pem
*.p12
*.key
*.jks
*.keystore
secrets/
credentials/
